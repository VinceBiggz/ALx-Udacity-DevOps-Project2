#!/bin/bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd) || { echo "UNAVAILABLE: repository root" >&2; exit 2; }
cd "$root" || { echo "UNAVAILABLE: repository directory" >&2; exit 2; }
python_bin=${PYTHON_BIN:-python3.12}
for command_name in "$python_bin" git curl shasum tar uname chmod mv; do
  command -v "$command_name" >/dev/null || { echo "UNAVAILABLE: $command_name required" >&2; exit 2; }
done
"$python_bin" -c 'import sys; sys.exit(0 if sys.version_info[:2] == (3,12) else 2)' || { echo "UNAVAILABLE: Python 3.12 required" >&2; exit 2; }
mkdir -p .tools || { echo "UNAVAILABLE: tools directory" >&2; exit 2; }
"$python_bin" -m venv .tools/venv || { echo "UNAVAILABLE: venv creation" >&2; exit 2; }
.tools/venv/bin/python -m pip install --disable-pip-version-check --require-hashes --only-binary=:all: -r bin/check-requirements.lock || { echo "UNAVAILABLE: pinned Python tools install failed" >&2; exit 2; }
[ "$(uname -s):$(uname -m)" = Darwin:arm64 ] || { echo "UNAVAILABLE: pinned tools target Darwin arm64" >&2; exit 2; }
expected=b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5
archive=.tools/gitleaks_8.30.1_darwin_arm64.tar.gz
if [ ! -f "$archive" ]; then
  curl --fail --silent --show-error --location --output "$archive.part" https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_darwin_arm64.tar.gz || { rm -f "$archive.part"; echo "UNAVAILABLE: pinned gitleaks download" >&2; exit 2; }
  actual=$(shasum -a 256 "$archive.part") || { echo "UNAVAILABLE: archive digest" >&2; exit 2; }
  [ "${actual%% *}" = "$expected" ] || { rm -f "$archive.part"; echo "FAIL: gitleaks archive SHA256" >&2; exit 1; }
  mv "$archive.part" "$archive" || { echo "UNAVAILABLE: archive cache write" >&2; exit 2; }
fi
actual=$(shasum -a 256 "$archive") || { echo "UNAVAILABLE: cached archive digest" >&2; exit 2; }
[ "${actual%% *}" = "$expected" ] || { echo "FAIL: cached gitleaks archive SHA256" >&2; exit 1; }
tar -xzf "$archive" -C .tools gitleaks || { echo "UNAVAILABLE: archive extraction" >&2; exit 2; }
chmod +x .tools/gitleaks || { echo "UNAVAILABLE: gitleaks permissions" >&2; exit 2; }
git config --local core.hooksPath .githooks || { echo "UNAVAILABLE: repository hooks configuration" >&2; exit 2; }
echo "SETUP PASS: repository-local pinned tools and hooks"
